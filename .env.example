# Analytics environment variables.
# Copy to .env.local and fill in the server secrets. IDs are never hardcoded in
# source — src/lib/analytics/ reads everything from process.env. See ADR 0005.

# ── Client-exposed IDs (public; shipped to the browser) — values from analytics.md ──
NEXT_PUBLIC_GA4_ID=G-LJEBV5NPCT
NEXT_PUBLIC_META_PIXEL_ID=1228338595957402
NEXT_PUBLIC_CLARITY_ID=wci5xmxfnu            # canonical shop project. wci589fgdr is RETIRED by the domain collapse (ADR 0002) — do NOT wire it.
NEXT_PUBLIC_REDDIT_PIXEL_ID=a2_hz77nm0joupm  # fired via a GTM tag, not a direct call in client.ts
NEXT_PUBLIC_GTM_ID=                          # single container post-collapse (ADR 0002) — value TBD

# ── Server-only SECRETS (never exposed to the browser; no values committed) ──
# trackServerEvent() is dead without these — G3 (checkout gate) fails silently if they're missing.
META_CAPI_ACCESS_TOKEN=                       # Meta Conversions API access token
GA4_API_SECRET=                               # GA4 Measurement Protocol api_secret

# ── Day-2 checkout backend (gate G2) — see ADR 0009 + checkout-architecture.md ──
# Values are NOT committed; Anton fills these in .env.local. Later steps add the
# code that consumes Resend / NowPayments / QStash — this step is DB foundation only.

# Neon Postgres (Drizzle). Pooled endpoint for runtime; direct (non-pooling)
# endpoint for schema migrations / drizzle-kit push.
POSTGRES_URL=                                 # Neon pooled connection string (runtime)
POSTGRES_URL_NON_POOLING=                     # Neon direct connection string (migrations)

# Resend — transactional email (later steps: confirmation / ops alert / nurture)
RESEND_API_KEY=                               # Resend API key
FROM_EMAIL=                                   # verified sender address
ADMIN_EMAIL=                                  # ops-alert recipient

# NowPayments — crypto invoice + HMAC-SHA512 IPN webhook (later steps)
NOWPAYMENTS_API_KEY=                          # NowPayments API key
NOWPAYMENTS_IPN_SECRET=                       # IPN signature secret (webhook verification)

# Upstash QStash — delayed abandoned-checkout nurture emails (later steps)
QSTASH_TOKEN=                                 # producer token (publish delayed jobs)
QSTASH_CURRENT_SIGNING_KEY=                   # consumer signature verification (current)
QSTASH_NEXT_SIGNING_KEY=                      # consumer signature verification (rotated)

# Base URL — used to build NowPayments invoice callback + QStash consumer URLs
NEXT_PUBLIC_BASE_URL=                         # e.g. https://isrib.shop
